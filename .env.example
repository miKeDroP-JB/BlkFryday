# ═══════════════════════════════════════════════════════════════════════════
# 0RB SYSTEM CONFIGURATION
# Copy this to .env and fill in your keys
# ═══════════════════════════════════════════════════════════════════════════

# AI Providers (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# Default Provider (anthropic, openai, groq, ollama)
ORB_DEFAULT_PROVIDER=anthropic

# Crypto/Web3 (optional)
PRIVATE_KEY=0x...
ALCHEMY_API_KEY=...
INFURA_API_KEY=...
ETHERSCAN_API_KEY=...

# Network (base, ethereum, polygon, arbitrum)
ORB_DEFAULT_NETWORK=base

# Outreach/Email (optional)
SENDGRID_API_KEY=SG....
RESEND_API_KEY=re_...
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Security
HYDRA_ENABLED=true
