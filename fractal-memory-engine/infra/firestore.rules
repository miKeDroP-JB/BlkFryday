rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User documents - only owner can read/write
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Subcollections inherit parent permissions
      match /{subcollection}/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Service account writes (for backend services)
    // These rules allow server-side writes using a service account
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth.token.service_account == true;
    }

    // Avatar configurations - public read for system, owner write
    match /users/{userId}/avatars/{avatarId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Raw signals - append only, owner can read
    match /users/{userId}/raw_signals/{signalId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
      allow update, delete: if false; // Immutable
    }

    // System configuration (admin only)
    match /system/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
  }
}
