{
  "name": "@blk/api",
  "version": "0.0.1",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "db:init": "psql $DATABASE_URL -f db/init.sql"
  },
  "dependencies": {
    "@blk/shared": "workspace:*",
    "@fastify/cors": "^8.4.0",
    "@fastify/websocket": "^8.2.0",
    "bullmq": "^4.0.0",
    "fastify": "^4.24.0",
    "ioredis": "^5.3.0",
    "pg": "^8.11.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
