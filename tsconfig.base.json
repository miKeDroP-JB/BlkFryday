{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "composite": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
