[Unit]
Description=VYRA Swarm Orchestrator
Documentation=https://vyra.dev/docs/orchestrator
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
Group=root
Environment=VYRA_HOME=/var/lib/vyra
Environment=VYRA_LOG_LEVEL=info
ExecStart=/usr/local/bin/vyra-orchestrator
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
LimitNOFILE=65535
LimitNPROC=65535

[Install]
WantedBy=multi-user.target
