[%General]
author=VYRA Genesis Sector
comment=Neon Ritual Theme for KDE
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=true
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=2
spread_progressbar=true
composite=true
menu_shadow_depth=10
spread_menuitems=true
tooltip_shadow_depth=6
scroll_width=12
scroll_arrows=false
scroll_min_extent=60
slider_width=6
slider_handle_width=22
slider_handle_length=22
tickless_slider_handle_size=22
center_toolbar_handle=true
check_size=16
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=true
blurring=true
popup_blurring=true
vertical_spin_indicators=false
spin_button_width=16
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
combo_as_lineedit=true
square_combo_button=true
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
spread_header=true
layout_spacing=4
layout_margin=9
submenu_overlap=0
tooltip_delay=-1
no_window_pattern=false
opaque=
reduce_window_opacity=0
reduce_menu_opacity=0
respect_DE=true
scrollbar_in_view=false
transient_scrollbar=true
transient_groove=true
button_contents_shift=false
tree_branch_line=true
no_inactiveness=false
dark_titlebar=true
inline_spin_indicators=true
joined_inactive_tabs=true
remove_extra_frames=true
drag_from_buttons=false
shadowless_popup=false
contrast=1.0
saturation=1.0
intensity=1.0
animate_states=true
click_behavior=0
dialog_button_layout=0
submenu_delay=200
no_focus_rect=

[GeneralColors]
window.color=#1a1b26
base.color=#15161e
alt.base.color=#1e1f2e
button.color=#24283b
light.color=#414868
mid.light.color=#33395a
dark.color=#0d0e14
mid.color=#1a1b26
highlight.color=#bb9af7
inactive.highlight.color=#565f89
text.color=#c0caf5
window.text.color=#c0caf5
button.text.color=#c0caf5
disabled.text.color=#565f89
tooltip.text.color=#c0caf5
highlight.text.color=#1a1b26
link.color=#7dcfff
link.visited.color=#bb9af7
progress.indicator.text.color=#c0caf5
progress.inactive.indicator.text.color=#c0caf5

[Hacks]
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=false
blur_translucent=true
transparent_ktitle_label=true
transparent_menutitle=true
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=100
lxqtmainmenu_iconsize=22
normal_default_pushbutton=true
single_top_toolbar=false
tint_on_mouseover=0
transparent_arrow_button=true
middle_click_scroll=false
scroll_jump_workaround=true
centered_forms=false
kinetic_scrolling=true
no_scroll_jump=true
inline_spin_separator=true
noninteger_translucency=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
indicator.size=10
text.normal.color=#c0caf5
text.focus.color=#c0caf5
text.press.color=#c0caf5
text.toggle.color=#1a1b26
text.shadow=0
text.margin=1
text.iconspacing=4
indicator.element=arrow
frame.expansion=10

[PanelButtonTool]
inherits=PanelButtonCommand

[Dock]
inherits=PanelButtonCommand
frame.element=dock
interior.element=dock
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.expansion=0

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#bb9af7
text.focus.color=#bb9af7

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=true
interior=true
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=arrow
indicator.size=10
text.normal.color=#c0caf5

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.normal.color=#c0caf5
text.focus.color=#c0caf5

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.normal.color=#c0caf5
text.focus.color=#c0caf5

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down
indicator.size=10

[IndicatorArrow]
indicator.element=arrow
indicator.size=10

[ToolboxTab]
inherits=PanelButtonCommand
text.normal.color=#c0caf5
text.press.color=#bb9af7
text.focus.color=#bb9af7

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
frame.top=2
frame.bottom=3
frame.left=3
frame.right=3
text.normal.color=#a9b1d6
text.focus.color=#c0caf5
text.press.color=#c0caf5
text.toggle.color=#bb9af7
indicator.element=tab
indicator.size=12
frame.expansion=0

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[TabBarFrame]
inherits=GenericFrame
frame=true
frame.element=tabbarframe
interior=false
frame.top=0
frame.bottom=4
frame.left=4
frame.right=4

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=10
indicator.element=tree

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=0
frame.bottom=1
frame.left=1
frame.right=1

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior.element=toolbar
text.normal.color=#c0caf5

[Scrollbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=10

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior=false
frame.left=6
frame.right=6
frame.top=6
frame.bottom=6
indicator.element=grip
indicator.size=0

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior.element=scrollbargroove

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.normal.color=#c0caf5
text.focus.color=#c0caf5
frame.expansion=18

[ProgressbarContents]
inherits=PanelButtonCommand
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color=#c0caf5
text.focus.color=#c0caf5
text.press.color=#c0caf5
text.toggle.color=#1a1b26

[Splitter]
indicator.size=32

[Slider]
inherits=PanelButtonCommand
frame=false
interior.element=slider
frame.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[SpinBox]
inherits=LineEdit

[Menu]
frame.element=menu
interior.element=menu
inherits=PanelButtonCommand
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.normal.color=#c0caf5

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuBarItem]
inherits=PanelButtonCommand
frame=false
interior.element=menubaritem
text.normal.color=#c0caf5
text.focus.color=#bb9af7
frame.expansion=0

[MenuItem]
inherits=PanelButtonCommand
frame=false
interior.element=menuitem
indicator.element=menuitem
text.normal.color=#c0caf5
text.focus.color=#c0caf5
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3
frame.expansion=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#c0caf5
text.focus.color=#bb9af7
text.bold=true

[ComboBox]
inherits=PanelButtonCommand
frame.element=combo
interior.element=combo
indicator.element=arrow-down
indicator.size=10
