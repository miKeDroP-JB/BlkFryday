{
  "name": "orb-system",
  "version": "11.5.0",
  "description": "0RB SYSTEM - ORBITAL FORGE + BRAIN NETWORK V11.5 - GODMODE ULTIMATE",
  "main": "system/core/MasterBrain.js",
  "scripts": {
    "start": "node boot/MasterBoot.js",
    "master": "node boot/MasterBoot.js",
    "boot": "node boot/MasterBoot.js",
    "boot:legacy": "node boot/init.js",
    "dev": "electron . --dev",
    "core": "node -e \"require('./core').createORB().then(o => console.log(o.getStatus()))\"",
    "factory": "node scripts/factory.js",
    "sentinel": "node -e \"require('./core').HydraSentinel && new (require('./core').HydraSentinel)().initialize()\"",

    "automate": "node scripts/automate.js daily",
    "automate:morning": "node scripts/automate.js morning",
    "automate:outreach": "node scripts/automate.js outreach",
    "automate:security": "node scripts/automate.js security",
    "automate:evening": "node scripts/automate.js evening",
    "schedule": "node scripts/automate.js schedule",

    "backup": "node scripts/backup.js",
    "backup:list": "node scripts/backup.js --list",
    "backup:restore": "node scripts/backup.js --restore",
    "backup:verify": "node scripts/backup.js --verify",
    "backup:schedule": "node scripts/backup.js --schedule",

    "server": "node server/index.js",
    "server:dev": "LOG_LEVEL=debug node server/index.js",
    "api": "node server/index.js",

    "quick-setup": "bash scripts/quick-setup.sh",

    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "build": "electron-builder",
    "build:usb": "node scripts/build-usb.js",
    "build:iso": "node scripts/create-iso.js",
    "web": "cd web && next dev",
    "web:build": "cd web && next build",
    "web:start": "cd web && next start",
    "contracts:compile": "cd contracts && npx hardhat compile",
    "contracts:test": "cd contracts && npx hardhat test",
    "contracts:deploy": "cd contracts && npx hardhat run scripts/deploy.js",
    "contracts:deploy:testnet": "cd contracts && npx hardhat run scripts/deploy.js --network baseSepolia",
    "setup": "bash setup/os-setup.sh",
    "test": "jest",
    "lint": "eslint .",
    "sync": "./scripts/sync-latest.sh",
    "train": "node --max-old-space-size=4096 scripts/train-forge.js",
    "train:forge": "node --max-old-space-size=4096 scripts/train-forge.js",
    "train:extended": "node --max-old-space-size=8192 scripts/train-forge.js --cycles=2000",
    "train:resume": "node --max-old-space-size=4096 scripts/train-forge.js --resume",
    "train:deep": "node --max-old-space-size=8192 scripts/train-forge.js --cycles=369 --resume",
    "reset": "node scripts/reset-memory.js --force",
    "reset:preview": "node scripts/reset-memory.js --dry-run",
    "train:fresh": "npm run reset && npm run train",
    "train:auto": "npm run train && npm run train:resume",
    "benchmark": "node --max-old-space-size=4096 benchmark/run.js"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.159.0",
    "@react-three/fiber": "^8.15.0",
    "@react-three/drei": "^9.88.0",
    "framer-motion": "^10.16.0",
    "ethers": "^6.9.0",
    "web3": "^4.3.0",
    "@solana/web3.js": "^1.87.0",
    "openai": "^4.20.0",
    "@anthropic-ai/sdk": "^0.32.0",
    "nodemailer": "^6.9.0",
    "@sendgrid/mail": "^8.1.0",
    "resend": "^2.0.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "howler": "^2.2.4",
    "gsap": "^3.12.0",
    "zustand": "^4.4.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "electron-builder": "^24.9.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.orb.system",
    "productName": "0RB SYSTEM",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg", "zip"]
    }
  },
  "keywords": ["orb", "ai", "agents", "copa", "simulation", "gaming", "orbital-forge", "brain-network"],
  "author": "0RB",
  "license": "MIT"
}
