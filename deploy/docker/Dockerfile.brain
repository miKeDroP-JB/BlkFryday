# ═══════════════════════════════════════════════════════════════════
# 0RB BRAIN SERVER - XEON DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════
# Optimized for Intel Xeon processors
# Run this on your local server infrastructure
# ═══════════════════════════════════════════════════════════════════

FROM node:20-bookworm

LABEL maintainer="0RB System"
LABEL description="0RB Brain Server - Neural Core"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /orb

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --production

# Copy system files
COPY system/ ./system/
COPY server/ ./server/
COPY config/ ./config/

# Environment
ENV NODE_ENV=production
ENV BRAIN_PORT=8420
ENV WS_PORT=8421

# Expose ports
EXPOSE 8420 8421

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8420/status || exit 1

# Start brain server
CMD ["node", "server/brain.js"]
